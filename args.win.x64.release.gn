target_os="win"
target_cpu = "x64"
v8_target_cpu="x64"
clang_use_chrome_plugins=false
chrome_pgo_phase=0
dcheck_always_on=false
enable_rust=false
is_cfi=false
is_asan=false
is_clang=true
is_component_build=false
is_debug=false
strip_debug_info=true
symbol_level=0
treat_warnings_as_errors=false
use_custom_libcxx=false
use_rtti=false
use_sysroot=false
v8_deprecation_warnings=false
v8_enable_builtins_optimization=true
v8_enable_gdbjit=false
# Preserve the current JS JIT tiers and native WebAssembly.
v8_enable_lite_mode=false
v8_jitless=false
v8_enable_drumbrake=false
v8_enable_sparkplug=true
v8_enable_turbofan=true
v8_enable_maglev=true
# Keep Maglev graph diagnostics on Windows.
v8_enable_maglev_graph_printer=true
v8_always_enable_maglev_graph_labeller=false
v8_enable_i18n_support=false
v8_enable_pointer_compression=false
v8_enable_sandbox=false
v8_enable_snapshot_compression=false
# Keep Windows tracing, profiling names, and native unwinding.
v8_enable_system_instrumentation=true
v8_enable_etw_stack_walking=true
v8_win64_unwinding_info=true
cppgc_enable_object_names=true
v8_enable_temporal_support=false
v8_enable_test_features=false
v8_enable_fuzztest=false
v8_enable_webassembly=true
v8_imminent_deprecation_warnings=false
v8_monolithic=true
# V8 15.7 Metagen rejects ExtendedMap's Windows padding (fields 73, size 76).
# Use the upstream Torque generator until Metagen supports this layout.
v8_use_metagen=false
v8_use_external_startup_data=false
